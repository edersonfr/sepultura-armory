# Credenciais da Battle.net API (https://develop.battle.net)
BLIZZARD_CLIENT_ID=seu_client_id_aqui
BLIZZARD_CLIENT_SECRET=seu_client_secret_aqui

# Configurações da Guilda no World of Warcraft: Forever
NEXT_PUBLIC_GUILD_NAME=Sepultura
NEXT_PUBLIC_GUILD_SLUG=sepultura
NEXT_PUBLIC_WOW_REGION=us
NEXT_PUBLIC_WOW_RULESET=normal
NEXT_PUBLIC_WOW_LOCALE=pt_BR

# Builds populares da calculadora (Upstash Redis).
# Na Vercel: Storage → Marketplace → Upstash Redis → Connect ao projeto
# (as variáveis KV_REST_API_URL e KV_REST_API_TOKEN são criadas sozinhas).
# Sem elas, o contador fica desligado e a seção de populares não aparece.
KV_REST_API_URL=
KV_REST_API_TOKEN=
